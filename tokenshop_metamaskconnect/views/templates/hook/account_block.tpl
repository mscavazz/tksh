<div id="ts-account-wallet" class="panel module ts-account-wallet">
  <h3 class="h3">{l s='TokenShop Wallet' mod='tokenshop_metamaskconnect'}</h3>
  <div class="content">
    <div id="ts-wallet-inner" class="ts-wallet-inner">
      <button id="ts-connect-metamask" class="btn btn-outline-primary btn-sm ts-connect-btn">🔗 {l s='Connecter MetaMask' mod='tokenshop_metamaskconnect'}</button>
      <div id="ts-wc-status" class="ts-wc-status" style="display:none; margin-left:10px;">
        <span id="ts-wc-address" class="ts-wc-address"></span>
        <button id="ts-wc-disconnect" class="btn btn-link btn-sm ts-disconnect">{l s='Déconnecter' mod='tokenshop_metamaskconnect'}</button>
        <button id="ts-wc-delete" class="btn btn-link btn-sm ts-delete">{l s='Supprimer mon wallet' mod='tokenshop_metamaskconnect'}</button>
      </div>
    </div>
    <p class="help-block small">{l s='Adresse affichée = adresse enregistrée en base. Les changements de compte doivent être confirmés pour être sauvegardés.' mod='tokenshop_metamaskconnect'}</p>
  </div>
</div>
